generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CHEF
  SIRKEL
  MALAZZ
}

model User {
  id                    String                 @id // Discord Snowflake ID or unique id
  username              String
  displayName           String?
  avatar                String?
  role                  UserRole               @default(MALAZZ)
  joinedGuildAt         DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  announcements         Announcement[]
  moments               Moment[]
  momentComments        MomentComment[]
  momentReactions       MomentReaction[]
  announcementComments  AnnouncementComment[]
  announcementReactions AnnouncementReaction[]

  @@map("users")
}

model Announcement {
  id        String                 @id @default(uuid())
  title     String
  content   String                 @db.Text
  category  String                 @default("PENTING") // PENTING, TURNAMEN, UPDATE, SANTAI
  isPinned  Boolean                @default(false)
  authorId  String
  author    User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  comments  AnnouncementComment[]
  reactions AnnouncementReaction[]

  @@index([isPinned, createdAt(sort: Desc)])
  @@map("announcements")
}

model AnnouncementComment {
  id             String       @id @default(uuid())
  content        String       @db.Text
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([announcementId, createdAt(sort: Asc)])
  @@map("announcement_comments")
}

model AnnouncementReaction {
  id             String       @id @default(uuid())
  emoji          String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([announcementId, userId, emoji])
  @@index([announcementId])
  @@map("announcement_reactions")
}

model Moment {
  id          String           @id @default(uuid())
  title       String
  description String?          @db.Text
  imageUrl    String
  category    String           @default("MABAR") // MABAR, CHAOS, VOICE, TOURNAMENT
  likes       Int              @default(0)
  authorId    String
  author      User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  capturedAt  DateTime? // Tanggal foto diambil dari metadata file
  createdAt   DateTime         @default(now())
  comments    MomentComment[]
  reactions   MomentReaction[]

  @@index([createdAt(sort: Desc)])
  @@index([capturedAt(sort: Desc)])
  @@map("moments")
}

model MomentComment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([momentId, createdAt(sort: Asc)])
  @@map("moment_comments")
}

model MomentReaction {
  id        String   @id @default(uuid())
  emoji     String // e.g. "🔥", "❤️", "💀", "😂", "🎉", "🗿"
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([momentId, userId, emoji])
  @@index([momentId])
  @@map("moment_reactions")
}
